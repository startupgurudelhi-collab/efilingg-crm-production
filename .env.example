# PostgreSQL Database Connection String (Direct single-source-of-truth)
# Format: postgresql://username:password@hostname:5432/database_name?sslmode=require
DATABASE_URL=

# Gemini API Key (Required for AI features)
GEMINI_API_KEY=

# Enterprise Feature Flags (Sprint 1.1) - All default to false
VITE_ENABLE_AI_SALES_WORKSPACE=false
VITE_ENABLE_WHATSAPP_INGESTION=false
VITE_ENABLE_AI_AGENTS=false
VITE_ENABLE_WORKFLOW_ENGINE=false
VITE_ENABLE_CUSTOMER360=false
VITE_ENABLE_AI_AUTOMATION=false
VITE_ENABLE_SUPERVISOR_DASHBOARD=false
