{
  "manifest_version": 3,
  "name": "Efilingg CRM GST Portal Auto-Login Assistant",
  "version": "2.1.0",
  "description": "Secure, corporate auto-filler for GST Portal logins within Efilingg CRM V2.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://services.gst.gov.in/*",
    "*://*.gst.gov.in/*",
    "*://localhost/*",
    "*://*.run.app/*",
    "*://efilingg.cloud/*",
    "*://*.efilingg.cloud/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://services.gst.gov.in/*",
        "*://*.gst.gov.in/*",
        "*://localhost/*",
        "*://*.run.app/*",
        "*://efilingg.cloud/*",
        "*://*.efilingg.cloud/*",
        "*://*/*",
        "<all_urls>"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
